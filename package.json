{
  "name": "guandan-lab",
  "version": "0.3.0-beta.23",
  "private": true,
  "description": "Open-source Guandan coach with a deterministic rules engine, AI practice partners, memory drills, and evidence-based replays.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mereithhh/guandan-lab.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "doctor": "node --env-file-if-exists=.env.local scripts/doctor.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.2",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.38",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vinext": "1.4.3",
    "vite": "8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "4.157.0"
  },
  "type": "module"
}
