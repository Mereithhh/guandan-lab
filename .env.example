# Public origin used for canonical and social metadata.
# After filling this file, run `npm run doctor`; the report never prints secrets.
SITE_URL=http://localhost:3000
# Optional public payment/support URL. When set, the footer renders its QR code.
SUPPORT_URL=

# Self-hosted guest accounts and SQLite progress sync. Use at least 24 random
# characters for SESSION_SECRET (for example: openssl rand -hex 32).
SESSION_SECRET=
DATABASE_PATH=/data/guandan.sqlite
# Optional Google OAuth. Register this callback URL with Google:
# ${SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Self-hosted four-player HTTP-polling rooms. Keep disabled until TLS and
# operational rate limits are configured for your deployment.
ONLINE_MATCHING_ENABLED=0

# Optional OpenAI-compatible agent provider. Server-side only.
# Must be explicitly enabled. Positive per-user and whole-site daily unit
# budgets are mandatory when this is 1; requests fail closed without them.
PAID_PROVIDERS_ENABLED=0
PAID_PROVIDER_USER_DAILY_UNITS=250
PAID_PROVIDER_GLOBAL_DAILY_UNITS=5000
# Relative units, not currency or exact token billing.
AI_AGENT_BUDGET_UNITS=1
AI_REVIEW_BUDGET_UNITS=2
ELEVENLABS_TTS_BUDGET_UNITS_PER_100_CHARS=1
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_OPEN_SECONDS=60
PAID_PROVIDER_MAX_INFLIGHT=8
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-* headers.
TRUST_PROXY=0
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Set to 1 only for a trusted LAN/self-hosted model endpoint.
AI_ALLOW_PRIVATE_BASE_URL=0

# Optional ElevenLabs TTS. Server-side only.
ELEVENLABS_API_KEY=
# Required fallback voice; character-specific IDs override it when present.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_COACH=
ELEVENLABS_VOICE_ID_WANG=
ELEVENLABS_VOICE_ID_GU=
ELEVENLABS_VOICE_ID_LIN=
# Flash v2.5 accepts an explicit zh/en language code and is suited to interactive play.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Optional per-language model overrides.
ELEVENLABS_MODEL_ID_ZH=
ELEVENLABS_MODEL_ID_EN=
